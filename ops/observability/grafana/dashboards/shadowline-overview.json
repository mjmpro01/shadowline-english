{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"shadowline-api\"}[5m])) or sum(rate(http_server_duration_milliseconds_count{job=\"shadowline-api\"}[5m])) or sum(rate(promhttp_metric_handler_requests_total{job=\"shadowline-api\"}[5m]))",
          "legendFormat": "requests",
          "refId": "A"
        }
      ],
      "title": "API request rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{job=\"shadowline-api\"}[5m])) by (le)) or histogram_quantile(0.95, sum(rate(http_server_duration_milliseconds_bucket{job=\"shadowline-api\"}[5m])) by (le)) / 1000",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "title": "API latency p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 15 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (worker) (rate(shadowline_jobs_processed_total[5m]))",
          "legendFormat": "{{worker}}",
          "refId": "A"
        }
      ],
      "title": "Worker jobs / s",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, worker) (rate(shadowline_job_duration_seconds_bucket[5m])))",
          "legendFormat": "{{worker}} p95",
          "refId": "A"
        }
      ],
      "title": "Worker job duration p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "id": 5,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{service=~\"api|scoring|cutting|dubbing|transcribing|glossing\"} |= ``",
          "refId": "A"
        }
      ],
      "title": "App + worker logs",
      "type": "logs"
    }
  ],
  "schemaVersion": 39,
  "tags": ["shadowline"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
