# Removes Docker images and build cache older than two weeks that no container
# uses. Every deploy leaves a few GB of images behind — the workers' image
# carries Whisper — and nothing else would ever remove them. Rolling back
# further than two weeks pulls the tag from the registry again.
# Started weekly by docker-prune.timer; see docs/deploy-prod.md, "Upkeep".
[Unit]
Description=Remove unused Docker images and build cache older than two weeks
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/docker image prune --all --force --filter until=336h
ExecStart=/usr/bin/docker builder prune --force --filter until=336h
