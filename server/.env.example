# Copy to .env and fill in. docker-compose reads this file.

# --- Postgres ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://shadowline:change-me@postgres:5432/shadowline?sslmode=disable

# --- Sessions ---------------------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -base64 32
SESSION_SECRET=

# --- Google OAuth -----------------------------------------------------------
# Create these at https://console.cloud.google.com/auth/clients:
#   Google Auth Platform -> Clients -> Create client
#   Application type: Web application
#   Authorised redirect URI: the OAUTH_REDIRECT_URL below, exactly
# Nothing in this project can create them for you. README.md walks through the
# rest of Google Auth Platform — note that while Audience says Testing, only
# the addresses listed there as test users can sign in, and everyone else is
# turned away as "cancelled".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Character-for-character one of the authorised redirect URIs above. A mismatch
# stops the learner at Google's own error screen, before this server sees it.
OAUTH_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Comma-separated. These addresses get the clip studio; everyone else does not.
ADMIN_EMAILS=you@example.com

# Where the React app is served from — used for CORS and the post-login redirect.
APP_ORIGIN=http://localhost:5173

# --- Object storage ---------------------------------------------------------
# Internal hostname Docker services use to reach MinIO.
S3_ENDPOINT=minio:9000
# Host:port stamped into presigned URLs the browser fetches. On Docker Compose
# that is localhost:9000 (MinIO's published port). Leave empty when S3_ENDPOINT
# is already a public address (real S3, a tunnel, etc.).
S3_PUBLIC_ENDPOINT=localhost:9000
S3_ACCESS_KEY=shadowline
S3_SECRET_KEY=change-me
S3_USE_SSL=0
S3_CLIPS_BUCKET=clips
S3_TAKES_BUCKET=takes

# Leave S3_ENDPOINT empty and set this instead to keep audio on local disk.
# DISK_ROOT=/var/lib/shadowline/blobs

# --- Transcription ----------------------------------------------------------
# Which Whisper model the transcriber runs. tiny.en is quick and loose;
# small.en is the default and the one worth trusting a learner with; medium.en
# costs roughly three times the CPU. Baked into the image at build time, so
# changing it means rebuilding.
# WHISPER_MODEL=small.en

# --- Word lookups ----------------------------------------------------------
# Meanings for words a learner taps in a caption, asked for in order: the
# dictionary first, the model for what it does not have. Both are optional —
# with neither, words still get a pronunciation from CMUdict.

# Merriam-Webster's Learner's Dictionary. Free for non-commercial use at 1,000
# lookups a day, which the cache makes plenty: a word is looked up once for the
# whole app, ever. Get a key at https://dictionaryapi.com (pick the LEARNER'S
# dictionary, not the Collegiate — the Collegiate is written for people who
# already have English).
#
# Two conditions come with the free tier and neither is optional: the
# Merriam-Webster logo has to appear wherever the definitions do, and an app
# that makes money needs a licence from them. The app credits the source under
# every definition; the logo itself still has to be added, per their brand
# guidelines.
# DICTIONARY_API_KEY=

# The Claude API, for the words no dictionary has — gonna, names, anything
# coined recently — and the only source that reads the sentence the word was
# tapped in. Priced per distinct word that gets this far, once, for ever:
# roughly $0.002 a word on the default model. claude-haiku-4-5 is about a fifth
# of that.
# ANTHROPIC_API_KEY=sk-ant-...
# GLOSS_MODEL=claude-opus-5

# --- Tests only -------------------------------------------------------------
# AUTH_FAKE=1 signs in anyone as any address, with no provider at all.
# It exists so the browser tests can run without real credentials. The server
# refuses to start with it set when APP_ORIGIN or OAUTH_REDIRECT_URL is https,
# which catches the obvious mistake but not every one — never set it outside
# tests.
# AUTH_FAKE=1
