# Copy to .env and fill in. docker-compose reads this file.

# --- Postgres ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://shadowline:change-me@postgres:5432/shadowline?sslmode=disable

# --- Sessions ---------------------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -base64 32
SESSION_SECRET=

# --- Google OAuth -----------------------------------------------------------
# Create these at https://console.cloud.google.com/auth/clients:
#   Google Auth Platform -> Clients -> Create client
#   Application type: Web application
#   Authorised redirect URI: the OAUTH_REDIRECT_URL below, exactly
# Nothing in this project can create them for you. README.md walks through the
# rest of Google Auth Platform — note that while Audience says Testing, only
# the addresses listed there as test users can sign in, and everyone else is
# turned away as "cancelled".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Character-for-character one of the authorised redirect URIs above. A mismatch
# stops the learner at Google's own error screen, before this server sees it.
OAUTH_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Comma-separated. These addresses get the clip studio; everyone else does not.
ADMIN_EMAILS=you@example.com

# Where the React app is served from — used for CORS and the post-login redirect.
APP_ORIGIN=http://localhost:5173

# --- Object storage ---------------------------------------------------------
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=shadowline
S3_SECRET_KEY=change-me
S3_USE_SSL=0
S3_CLIPS_BUCKET=clips
S3_TAKES_BUCKET=takes

# Leave S3_ENDPOINT empty and set this instead to keep audio on local disk.
# DISK_ROOT=/var/lib/shadowline/blobs

# --- Tests only -------------------------------------------------------------
# AUTH_FAKE=1 signs in anyone as any address, with no provider at all.
# It exists so the browser tests can run without real credentials. The server
# refuses to start with it set when APP_ORIGIN or OAUTH_REDIRECT_URL is https,
# which catches the obvious mistake but not every one — never set it outside
# tests.
# AUTH_FAKE=1
